    "mcp-ucsc-genome": "bin/cli.js"
  },
  "files": ["bin/", "lib/", "tools.json", "server.json"],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "pipeworx", "ucsc-genome"],
