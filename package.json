  "repository": {
    "type": "git",
    "url": "git+https://github.com/pipeworx-io/mcp-ucsc-genome.git"
  },
  "mcpName": "io.github.pipeworx-io/ucsc-genome",
  "pipeworx": {
    "mode": "gateway",
